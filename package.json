{
  "name": "@filebouncer/core",
  "version": "0.6.0",
  "description": "Lightweight Node.js library for structural validation of uploaded files.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "core": "./dist/cli.js",
    "filebouncer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "file-upload",
    "validation",
    "mime",
    "scanner",
    "cli",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ramzi-Abidi/fileBouncer.git"
  },
  "bugs": {
    "url": "https://github.com/Ramzi-Abidi/fileBouncer/issues"
  },
  "homepage": "https://github.com/Ramzi-Abidi/fileBouncer#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "file-type": "^21.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5",
    "yazl": "^3.3.1"
  }
}
